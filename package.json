{
  "name": "teachit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TeachIt local Excalidraw whiteboard for macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "desktop:mac": "npm run build && electron-builder --mac dir dmg",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node scripts/copy-excalidraw-fonts.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.teachit.whiteboard",
    "productName": "TeachIt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "electronLanguages": ["en-US"],
      "extendInfo": {
        "NSCameraUsageDescription": "TeachIt uses your camera to show an optional floating presenter view on the whiteboard recording.",
        "NSMicrophoneUsageDescription": "TeachIt uses your microphone to include your voice in whiteboard recordings."
      },
      "fileAssociations": [
        {
          "ext": "excalidraw",
          "name": "Excalidraw Drawing",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": "excalidrawlib",
          "name": "Excalidraw Library",
          "role": "Editor",
          "rank": "Alternate"
        }
      ],
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    }
  }
}
